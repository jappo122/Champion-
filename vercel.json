{
  "buildCommand": "npm run build && npx esbuild dist/server/server.js --bundle --platform=node --format=esm --outfile=api/ssr-bundled.mjs --external:node:*",
  "installCommand": "npm install",
  "outputDirectory": "dist/client",
  "rewrites": [
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/api/mark-complete", "destination": "/api/mark-complete" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/(.*)", "destination": "/api/ssr" }
  ]
}
